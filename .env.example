# v1 runtime wiring
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
INGRESS_MAX_IN_FLIGHT=1024
INGRESS_REQUEST_TIMEOUT_MS=5000
MAX_REQUEST_BYTES=65536
MAX_ROUTE_CANDIDATES=16
MAX_SOURCE_HASHES=16

COMPUTE_HOST=127.0.0.1
COMPUTE_PORT=50051

POSTGRES_URL=jdbc:postgresql://127.0.0.1:5432/decision_store
POSTGRES_USER=decision
POSTGRES_PASSWORD=decision
POSTGRES_POOL_SIZE=8
POSTGRES_CONNECTION_TIMEOUT_MS=5000

VALKEY_URI=redis://127.0.0.1:6379/0
DEDUPE_TTL_SECONDS=3600

AUDIT_BOOTSTRAP_SERVERS=127.0.0.1:9092
AUDIT_TOPIC=solana.audit
